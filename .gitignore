# Somente a organização do ecossistema entra no Git da raiz.
/*
!/.gitignore
!/README.md
!/CLAUDE.md
!/AGENTS.md
!/EAPA-Ecossistema.Rproj
!/APOIO/
!/ATIVIDADES/
!/skills/
/skills/*
!/skills/eapa-projetos-analise/
# Cadernos sao repositorios proprios; nao versionar dentro do raiz
/EAPACadernos/

# Arquivos locais do R e do RStudio.
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# Arquivo histórico, temporários e artefatos locais de homologação.
/APOIO/_legado/
/APOIO/temp/
/APOIO/tmp/
/APOIO/saida-sandbox/
/APOIO/transferencia-vm/
/APOIO/Rplots.pdf

# Dependências, caches e configurações locais das ferramentas.
node_modules/
__pycache__/
.venv/
.agents/
.git/
*.inspect.ndjson

# Arquivos de bloqueio de documentos abertos.
.~lock.*#
~$*

# Sub-repositorios independentes (versionados nos proprios repos)
/CATALYSER/
/EAPA/
/EAPADados/
# Script auxiliar de envio (nao versionar)
/enviar_ao_github.R
**/node_modules/

# node_modules as vezes e link simbolico (npm/pnpm): sem barra pega link e pasta
node_modules
**/node_modules
# Artefato zip solto em APOIO
/APOIO/descritiva-barbo.zip

# Pacotes de distribuição e entregas da CatalyseR (grandes; vão para GitHub Releases, não para o git)
/APOIO/CatalyseR-Windows-*
/APOIO/CatalyseR-avaliacao-*
/APOIO/entrega-avaliacao-*/
/APOIO/**/*.zip
# Teste de instalação: biblioteca instalada e cópia da fonte, gerados a cada teste
/APOIO/teste-instalacao-sem-rtools/
# Logs e renderizações usados só para conferência
/APOIO/**/*.log
/APOIO/*_log.txt
/APOIO/**/word-render/
/APOIO/revisao-planejamento-transversal/pagina-*.png
/APOIO/revisao-planejamento-transversal/verificacao.pdf
